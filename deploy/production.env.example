# Скопируй в server/.env на VPS:
#   cp deploy/production.env.example server/.env
#   nano server/.env

# --- PostgreSQL ---
DATABASE_URL=postgresql://landing:CHANGE_DB_PASSWORD@127.0.0.1:5432/landing
PORT=4000
UPLOAD_DIR=./uploads
HOST=0.0.0.0

# --- Вход в админку https://ваш-домен/admin/ ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ADMIN_PASSWORD

# Второй пользователь (опционально — удали строки, если не нужен)
EDITOR_USERNAME=editor
EDITOR_PASSWORD=CHANGE_EDITOR_PASSWORD

# --- Cookies / SSL ---
# COOKIE_SECURE=true обязателен за HTTPS
COOKIE_SECRET=CHANGE_TO_LONG_RANDOM_STRING
COOKIE_SECURE=true
